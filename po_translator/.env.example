# Azure OpenAI Configuration
# Copy this file to .env and fill in your actual values

# Azure OpenAI Endpoint URL
AZURE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/

# Azure OpenAI API Key
AZURE_API_KEY=your-api-key-here

# Azure OpenAI API Version
AZURE_API_VERSION=2024-12-01-preview

# Azure OpenAI Deployment Name
AZURE_DEPLOYMENT_NAME=gpt-4.1-mini

# Target Language for Translation
TARGET_LANGUAGE=Korean

# Translation Configuration
CHUNK_SIZE=100
MAX_RETRIES=3
RETRY_DELAY=2

# System Prompt for Translation Context
# This helps provide context about the software being translated
SYSTEM_PROMPT=You are a professional software translator specializing in translating Frappe/ERPNext applications. You understand business software terminology and maintain consistency across translations. Preserve exact spacing, placeholders like {0} %s, and formatting. Keep leading and trailing whitespace characters in msgid in msgstr.

# Translation Context (optional)
# Provide additional context about the project being translated
TRANSLATION_CONTEXT=This is a translation for Frappe-based applications including Drive (file management), Helpdesk (customer service), and Raven (communication platform). Maintain professional business terminology and user interface consistency.
